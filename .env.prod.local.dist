# Vorlage für die Produktions-Umgebung.
# Kopieren nach ".env.prod.local" und Werte ausfüllen. NICHT committen.

# Deine Domain – FrankenPHP holt dafür automatisch ein HTTPS-Zertifikat.
SERVER_NAME=papa.example.com

# Vollständige Basis-URL (für Links in CLI/Mails).
DEFAULT_URI=https://papa.example.com

# Zufälliger Geheimschlüssel, z. B. erzeugen mit:
#   php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=BITTE_AENDERN

# Datenbank (SQLite). Liegt bewusst in einem eigenen Ordner und nicht unter
# var/, damit sie beim Aufräumen oder Deployen nicht mit weggeht.
DATABASE_URL="sqlite:///%kernel.project_dir%/data/data_prod.db"

# Echter Mailversand – Beispiel eigener SMTP:
MAILER_DSN=smtp://benutzer:passwort@mail.example.com:587
MAILER_FROM="Papa-Wächter <papa-waechter@example.com>"

# Alarm-Parameter.
ALERT_THRESHOLD_HOURS=26
ALERT_REMINDER_HOURS=12
# Nach so vielen Stunden zeigt Papas Seite wieder den grünen Knopf.
CHECKIN_WINDOW_HOURS=6
APP_TIMEZONE=Europe/Berlin
