<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Lebenszeichen</title>

    {# PWA / Homescreen (iOS) – alles lokal, kein CDN #}
    <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
    <meta name="theme-color" content="#2e7d32">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Lebenszeichen">
    <link rel="apple-touch-icon" href="{{ asset('icons/icon-180.png') }}">
    <link rel="icon" href="{{ asset('icons/icon-192.png') }}">

    <link rel="stylesheet" href="{{ asset('checkin.css') }}">
</head>
{#- Beide Zustände stehen im Dokument; welcher sichtbar ist, entscheidet das
    Skript unten. Ohne JavaScript bleibt es bei dem, was der Server gerendert
    hat – dann ist die Seite eben erst nach dem Neuladen wieder aktuell. -#}
<body class="{{ state.photoUrl ? 'has-photo' : '' }}{{ state.confirmed ? ' confirmed' : '' }}"
      data-status-url="{{ path('app_checkin_status', {token: token}) }}"
      data-state="{{ state|json_encode|e('html_attr') }}">
    {% if state.photoUrl %}
        {# Familienfoto des Tages. <img> statt CSS-Hintergrund, damit iOS die
           EXIF-Drehung von Handyfotos berücksichtigt. #}
        <img class="bg-photo" id="bg-photo" src="{{ state.photoUrl }}" alt="">
        <div class="bg-scrim"></div>
    {% endif %}

    <main class="wrap">
        <div class="status done" id="view-done"{{ state.confirmed ? '' : ' hidden' }}>
            <div class="big-check">✓</div>
            <p class="title">Danke, {{ watchee.name }}!</p>
            <p class="sub" id="done-sent">Dein Lebenszeichen ist angekommen.</p>
            {# Nur zu sehen, solange ein Tipp noch unterwegs ist – checkin.js
               schaltet um und schickt ihn nach, sobald wieder Netz da ist. #}
            <p class="sub" id="done-sending" hidden>Dein Lebenszeichen wird gesendet&nbsp;…</p>
            <p class="sub" id="done-offline" hidden>
                Das iPad hat gerade keine Verbindung. Dein Lebenszeichen wird
                nachgeschickt, sobald sie wieder da ist – du musst nichts tun.
            </p>
            <p class="next-info">
                Der grüne Knopf ist ab <strong id="next-at">{{ state.nextText }}</strong> Uhr
                wieder da.
            </p>
        </div>

        <div id="view-ask"{{ state.confirmed ? ' hidden' : '' }}>
            <h1>Hallo {{ watchee.name }}!</h1>
            <p class="greeting">Alles in Ordnung?</p>

            {# Mit JavaScript schickt checkin.js den Tipp selbst (und notfalls
               später nach); das Formular ist der Weg ohne JavaScript. #}
            <form class="confirm-form" id="confirm-form" method="post" action="{{ path('app_checkin_confirm', {token: token}) }}">
                {# Füllt checkin.js: der User-Agent verrät nicht, ob hier ein
                   iPad oder ein Mac tippt – Apple sendet für beide dasselbe.
                   Bleibt leer, wenn kein JavaScript läuft. #}
                <input type="hidden" name="geraet" id="device-hint" value="">
                {# Wann der Server diese Seite erzeugt hat – fürs Zugriffs-Log. #}
                <input type="hidden" name="stand" value="{{ state.now }}">
                <button type="submit" class="confirm-btn">
                    <span class="check">✓</span>
                    Mir geht&rsquo;s gut
                </button>
            </form>
        </div>

        <p class="last-info" id="last-info"{{ state.lastText ? '' : ' hidden' }}>
            Zuletzt bestätigt: <span id="last-at">{{ state.lastText }}</span> Uhr
        </p>

        <p class="footer-note">
            Ein Tipp am Morgen und einer am Abend. Deine Kinder sehen dann,
            dass alles gut ist.
        </p>
    </main>

    <script src="{{ asset('checkin.js') }}"></script>
</body>
</html>
