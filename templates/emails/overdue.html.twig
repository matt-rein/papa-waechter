{% set w = status.watchee %}
<!DOCTYPE html>
<html lang="de">
<body style="font-family: Arial, Helvetica, sans-serif; color:#1a2230; line-height:1.6;">
    <div style="max-width:520px; margin:0 auto; padding:24px;">
        <h2 style="color:#c0392b; margin-top:0;">
            {% if isReminder %}Erinnerung: weiterhin kein Lebenszeichen{% else %}Kein Lebenszeichen von {{ w.name }}{% endif %}
        </h2>

        <p>
            {{ w.name }} hat sich seit über <strong>{{ status.thresholdHours }} Stunden</strong>
            nicht mehr gemeldet.
        </p>

        <p>
            {% if status.last %}
                Letzte Bestätigung:
                <strong>{{ status.last.occurredAt|date('d.m.Y \\u\\m H:i', timezone) }} Uhr</strong>
                {% if status.hoursSince is not null %}
                    (vor rund {{ status.hoursSince|round }} Stunden){% endif %}.
            {% else %}
                Es liegt bislang <strong>überhaupt kein</strong> Lebenszeichen vor.
            {% endif %}
        </p>

        <p style="background:#fdecea; border:1px solid #f5c6c2; border-radius:8px; padding:12px 16px;">
            Bitte kurz nach {{ w.name }} sehen oder anrufen.
        </p>

        <p style="color:#66707e; font-size:0.9em;">
            Diese Nachricht wurde automatisch vom Papa-Wächter-System erstellt.
            {% if isReminder %}Du erhältst sie erneut, weil der Alarm weiterhin aktiv ist.{% endif %}
        </p>
    </div>
</body>
</html>
