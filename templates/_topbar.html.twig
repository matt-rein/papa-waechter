{#- Kopfzeile mit Navigation. Nur für angemeldete Wächter sichtbar.
    Erwartet optional: active ('dashboard'|'photos'|'guardians') -#}
{% set active = active|default('') %}
<div class="topbar">
    <span class="brand">🟢 Papa-Wächter</span>

    <nav class="nav">
        <a href="{{ path('app_dashboard') }}" {{ active == 'dashboard' ? 'class="current"' : '' }}>Übersicht</a>
        <a href="{{ path('app_photo_index') }}" {{ active == 'photos' ? 'class="current"' : '' }}>Fotos</a>
        <a href="{{ path('app_guardian_index') }}" {{ active == 'guardians' ? 'class="current"' : '' }}>Wächter</a>
    </nav>

    <span class="topbar-right">
        <span class="user">{{ app.user.name ?? app.user.userIdentifier }}</span>
        <form method="post" action="{{ path('app_logout') }}">
            <button class="logout" type="submit">Abmelden</button>
        </form>
    </span>
</div>
