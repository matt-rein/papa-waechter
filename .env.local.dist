# Vorlage für klassisches Hosting (DomainFactory).
#
# Auf dem Server einmalig nach ".env.local" kopieren und ausfüllen.
# NICHT committen – die Datei ist vom Deploy ausgenommen und bleibt stehen.
#
# (Für den Docker-Betrieb gilt stattdessen .env.prod.local.dist.)

# Ohne diese Zeile läuft die App im Entwicklungsmodus. Der Deploy bricht ab,
# wenn sie fehlt.
APP_ENV=prod
APP_DEBUG=0

# Zufälliger Geheimschlüssel, z. B. erzeugen mit:
#   php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=BITTE_AENDERN

# Vollständige Basis-URL – steckt in den Links in Alarm-Mails und in der
# Ausgabe von app:watchee:create.
DEFAULT_URI=https://reinhardt.onl

# Echter Mailversand (SMTP-Zugang bei DomainFactory).
MAILER_DSN=smtp://benutzer:passwort@smtp.df.eu:587
MAILER_FROM="Papa-Wächter <papa-waechter@reinhardt.onl>"

# Alarm-Parameter.
ALERT_THRESHOLD_HOURS=26
ALERT_REMINDER_HOURS=12
# Nach so vielen Stunden zeigt Papas Seite wieder den grünen Knopf.
CHECKIN_WINDOW_HOURS=6
APP_TIMEZONE=Europe/Berlin

# Pfad des Bilder-Ordners, wie er auf der Fotoseite zum Kopieren angezeigt wird.
APP_PHOTO_DIR_LABEL=/kunden/123456_78901/papa-waechter/photos

# Wird vom Deploy automatisch auf den Git-SHA gesetzt – hier nichts eintragen.
APP_ASSET_VERSION=initial

# Die Datenbank liegt per Vorgabe in data/data_prod.db. Nur ändern, wenn sie
# woanders liegen soll:
# DATABASE_URL="sqlite:///%kernel.project_dir%/data/data_prod.db"
